---
import PageLayout from '@/layouts/PageLayout.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import Form from '@/components/forms/Form.astro';
import { generateWebPageJsonLd } from '@/lib/json-ld';
import { SITE_URL, CONTACT_HERO, CONTACT_SUB, CONTACT_SIDE_TITLE, CONTACT_SIDE_TEXT, CONTACT_PRIVACY } from '@/lib/constants';

const jsonLd = JSON.stringify(generateWebPageJsonLd({
  title: 'Conversar',
  description: 'Antes de falar sobre solução, queremos entender o que precisa mudar.',
  url: `${SITE_URL}/conversar`,
}));
---

<PageLayout
  title="Conversar"
  description="Antes de falar sobre solução, queremos entender o que precisa mudar."
  jsonLd={jsonLd}
>

  {/* ═══════════════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════════════ */}
  <Section class="pt-16 lg:pt-28 pb-16 lg:pb-24">
    <Container>
      <div class="max-w-4xl">
        <Eyebrow text="Conversar" class="mb-8" />
        <Heading tag="h1" size="hero" class="mb-8 text-balance">
          {CONTACT_HERO}
        </Heading>
        <p class="text-body-xl text-venturare-muted/80 max-w-2xl leading-relaxed">
          {CONTACT_SUB}
        </p>
      </div>
    </Container>
  </Section>

  <Section padding="xl" border>
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        {/* Formulário */}
        <div class="lg:col-span-7">
          <div class="max-w-2xl">
            <Form />
          </div>
        </div>

        {/* Lateral */}
        <div class="lg:col-span-5">
          <div class="max-w-md lg:pl-8 lg:border-l lg:border-venturare-border/30">
            <Eyebrow text={CONTACT_SIDE_TITLE} class="mb-8" />
            <p class="text-body-xl text-venturare-muted/80 leading-relaxed">
              {CONTACT_SIDE_TEXT}
            </p>
            <p class="text-small text-venturare-muted/70 mt-10">
              {CONTACT_PRIVACY}
            </p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

</PageLayout>