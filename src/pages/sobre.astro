---
import PageLayout from '@/layouts/PageLayout.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import Button from '@/components/ui/Button.astro';
import { generateWebPageJsonLd } from '@/lib/json-ld';
import {
  SITE_URL,
  SOBRE_HERO_TEXT,
  SOBRE_PORQUE_EXISTIMOS_TITLE,
  SOBRE_PORQUE_EXISTIMOS_TEXT,
  SOBRE_PORQUE_EXISTIMOS_CLOSE,
  SOBRE_CRENCA,
  SOBRE_CRENCA_NOTE,
  SOBRE_OQUE_APOIO,
  SOBRE_OQUE_LINES,
  SOBRE_OQUE_CLOSE,
  SOBRE_ATUAR,
  SOBRE_LIDERANCA_EYEBROW,
  FOUNDER,
  FOUNDER_ROLE,
  FOUNDER_QUOTE,
  FOUNDER_TEXT,
  FOUNDER_CTA,
  FOUNDER_LINKEDIN,
  SOBRE_DIFERENCIAL,
  SOBRE_DIFERENCIAL_CLOSE,
  SOBRE_CTA_HERO,
  SOBRE_CTA_SUB,
} from '@/lib/constants';

const jsonLd = JSON.stringify(generateWebPageJsonLd({
  title: 'Sobre a Venturare',
  description: 'Uma consultoria boutique criada para aproximar estratégia, tecnologia e execução — com compreensão e direção antes da ação.',
  url: `${SITE_URL}/sobre`,
}));
---

<PageLayout
  title="Sobre a Venturare"
  description="Uma consultoria boutique criada para aproximar estratégia, tecnologia e execução — com compreensão e direção antes da ação."
  jsonLd={jsonLd}
>

  {/* ═══════════════════════════════════════════════════
       1. HERO — A IDENTIDADE
       ═══════════════════════════════════════════════════ */}
  <Section padding="none" class="relative min-h-[680px] lg:min-h-[760px] flex items-end lg:items-center overflow-hidden pt-28 lg:pt-32 pb-14 lg:pb-16" tone="dark">
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <img
        src="/images/sobre/hero.png"
        alt=""
        width="1672"
        height="941"
        class="absolute inset-0 h-full w-full object-cover object-center"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 lg:hidden bg-gradient-to-t from-venturare-black via-venturare-black/75 to-venturare-black/40"></div>
      <div class="hidden lg:block absolute inset-0 bg-gradient-to-r from-venturare-black via-venturare-black/80 to-venturare-black/25"></div>
    </div>

    <Container class="relative z-10">
      <div class="max-w-4xl">
        <Eyebrow text="Sobre" class="mb-8" />
        <Heading tag="h1" size="hero" class="mb-8 max-w-[15ch] text-balance">
          NÃO É SOBRE
          <br />FAZER MAIS.
          <br />
          É SOBRE FAZER
          <br />
          <span class="text-venturare-green">O QUE IMPORTA.</span>
        </Heading>
        <p class="text-body-xl text-venturare-muted/80 max-w-xl leading-relaxed mb-10">
          {SOBRE_HERO_TEXT}
        </p>
        <div class="mb-12">
          <Button href="/conversar" variant="primary" size="lg">
            Conversar com a Venturare
            <span class="ml-1">&rarr;</span>
          </Button>
        </div>
        <p class="text-caption text-venturare-muted/80 uppercase tracking-[0.25em] flex items-center gap-3">
          <span class="h-px w-8 bg-venturare-green/40" aria-hidden="true"></span>
          Transformando Visão em Resultados
        </p>
      </div>
    </Container>
  </Section>

  {/* ═══════════════════════════════════════════════════
       2. POR QUE EXISTIMOS
       ═══════════════════════════════════════════════════ */}
  <Section padding="xl" border tone="dark" class="bg-venturare-graphite/35">
    <Container>
      <div class="max-w-3xl mx-auto text-center">
        <Eyebrow text="Por que existimos" class="mb-8" />
        <Heading tag="h2" size="h2" class="mb-8 text-balance">
          {SOBRE_PORQUE_EXISTIMOS_TITLE.split('. ')[0]}.
          <span class="block text-venturare-green">Precisa de decisões melhores.</span>
        </Heading>
        <div class="max-w-2xl mx-auto space-y-6">
          <p class="text-body-lg text-venturare-muted/80 leading-relaxed">
            {SOBRE_PORQUE_EXISTIMOS_TEXT}
          </p>
          <p class="text-h4 font-serif italic text-venturare-white/80 leading-relaxed">
            {SOBRE_PORQUE_EXISTIMOS_CLOSE}
          </p>
        </div>
      </div>
    </Container>
  </Section>

  {/* ═══════════════════════════════════════════════════
       3. NOSSA CRENÇA — momento cinematográfico
       ═══════════════════════════════════════════════════ */}
  <Section padding="none" tone="dark">
    <div class="relative overflow-hidden py-28 lg:py-40">
      <div class="absolute inset-0 sobre-grid sobre-glow-navy" aria-hidden="true"></div>
      <Container class="relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <Eyebrow text="Nossa crença" class="mb-10" />
          <Heading tag="h2" size="h2" class="text-balance leading-tight">
            {SOBRE_CRENCA[0]}
            <span class="block text-venturare-green">{SOBRE_CRENCA[1]}</span>
          </Heading>
          <p class="text-body-lg font-serif italic text-venturare-muted/80 mt-10">
            {SOBRE_CRENCA_NOTE}
          </p>
        </div>
      </Container>
    </div>
  </Section>

  {/* ═══════════════════════════════════════════════════
       4. O QUE É A VENTURARE
       ═══════════════════════════════════════════════════ */}
  <Section padding="xl" border tone="dark">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-20">
        <div class="lg:col-span-6">
          <Eyebrow text="O que é a Venturare" class="mb-8" />
          <Heading tag="h2" size="h2" class="text-balance">
            ESTRATÉGIA ANTES
            <br />DA TECNOLOGIA.
            <br />
            NEGÓCIO ANTES
            <br />DA EXECUÇÃO.
          </Heading>
        </div>
        <div class="lg:col-span-6">
          <p class="text-body-xl text-venturare-muted/80 max-w-xl leading-relaxed mb-12">
            {SOBRE_OQUE_APOIO}
          </p>
          <div class="border-l-2 border-venturare-green/40 pl-6 lg:pl-8">
            {SOBRE_OQUE_LINES.map((line) => (
              <p class="text-h4 font-serif italic text-venturare-white/80 leading-relaxed">{line}</p>
            ))}
            <p class="text-h4 font-display font-bold text-venturare-green mt-4">
              {SOBRE_OQUE_CLOSE}
            </p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  {/* ═══════════════════════════════════════════════════
       6. NOSSO JEITO DE ATUAR — princípios em grafite
       ═══════════════════════════════════════════════════ */}
  <Section padding="xl" border tone="subtle">
    <Container>
      <div class="max-w-3xl mb-16">
        <Eyebrow text="Nossos princípios" />
        <Heading tag="h2" size="h2" class="mb-6">
          Princípios que orientam <span class="text-venturare-green">cada trabalho</span>.
        </Heading>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 gap-y-14">
        {SOBRE_ATUAR.map((principle) => (
          <div class="border-t border-venturare-border/25 pt-7">
            <div class="flex gap-5 mb-4">
              <span class="text-h4 font-display font-bold text-venturare-green-dim shrink-0">{principle.num}</span>
              <p class="text-h4 text-venturare-white font-display font-semibold tracking-tight">
                {principle.label}
              </p>
            </div>
            <p class="text-body-lg text-venturare-muted/80 leading-relaxed max-w-md">
              {principle.text}
            </p>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  {/* ═══════════════════════════════════════════════════
       7. POR TRÁS DA VENTURARE
       ═══════════════════════════════════════════════════ */}
  <Section padding="xl" border tone="dark">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-center">
        <div class="lg:col-span-5">
          <div class="relative aspect-[3/4] lg:aspect-[4/5] rounded-md overflow-hidden border border-venturare-border/20">
            <img
              src="/images/sobre/ceo.png"
              alt={`${FOUNDER}, ${FOUNDER_ROLE.toUpperCase()} da Venturare`}
              width="1374"
              height="1145"
              class="absolute inset-0 h-full w-full object-cover object-top"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-venturare-black/80 via-transparent to-transparent" aria-hidden="true"></div>
          </div>
        </div>
        <div class="lg:col-span-7">
          <Eyebrow text={SOBRE_LIDERANCA_EYEBROW} class="mb-8" />
          <Heading tag="h2" size="h2" class="mb-3">
            {FOUNDER}
          </Heading>
          <p class="text-caption text-venturare-green uppercase tracking-widest mb-8">{FOUNDER_ROLE.toUpperCase()}</p>
          <p class="text-h4 font-serif italic text-venturare-white/85 leading-relaxed max-w-xl mb-8">
            &ldquo;{FOUNDER_QUOTE}&rdquo;
          </p>
          <p class="text-body text-venturare-muted/80 leading-relaxed max-w-xl mb-10">
            {FOUNDER_TEXT}
          </p>
          <div>
            <Button href={FOUNDER_LINKEDIN} variant="secondary" target="_blank" rel="noopener noreferrer">
              {FOUNDER_CTA}
              <span class="ml-1">&rarr;</span>
            </Button>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  {/* ═══════════════════════════════════════════════════
       8. O QUE NOS DIFERENCIA — trajetória sutil
       ═══════════════════════════════════════════════════ */}
  <Section padding="xl" border tone="dark">
    <Container>
      <div class="max-w-3xl mx-auto text-center">
        <Eyebrow text="O que nos diferencia" class="mb-8" />
        <Heading tag="h2" size="h2" class="mb-12 text-balance">
          NÃO SE TRATA DE TER
          <br />MAIS RECURSOS.
          <br />
          <span class="text-venturare-green">TRATA-SE DE CONECTAR
            <br />AS CAPACIDADES CERTAS.</span>
        </Heading>

        <div class="flex items-center justify-center gap-4 mb-4" aria-hidden="true">
          <span class="h-px w-12 bg-gradient-to-r from-transparent to-venturare-green/40"></span>
          <span class="w-1.5 h-1.5 rotate-45 bg-venturare-green/50"></span>
          <span class="h-px w-12 bg-gradient-to-l from-transparent to-venturare-green/40"></span>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-4 mb-12">
          {SOBRE_DIFERENCIAL.map((capability, i) => (
            <>
              <span class="text-h4 lg:text-h3 text-venturare-white font-display font-bold tracking-wide">
                {capability}
              </span>
              {i < SOBRE_DIFERENCIAL.length - 1 && (
                <span class="text-venturare-green/50" aria-hidden="true">/</span>
              )}
            </>
          ))}
        </div>

        <p class="text-body-lg font-serif italic text-venturare-muted/80 max-w-xl mx-auto leading-relaxed">
          {SOBRE_DIFERENCIAL_CLOSE}
        </p>
      </div>
    </Container>
  </Section>

  {/* ═══════════════════════════════════════════════════
       9. CTA FINAL
       ═══════════════════════════════════════════════════ */}
  <Section padding="xl" border tone="dark">
    <Container>
      <div class="max-w-3xl mx-auto text-center">
        <Eyebrow text="Vamos conversar" class="mb-8" />
        <Heading tag="h2" size="h2" class="mb-8 text-balance">
          {SOBRE_CTA_HERO.split(' ').slice(0, 4).join(' ')}
          <br />COM UMA <span class="text-venturare-green">DECISÃO.</span>
        </Heading>
        <p class="text-body-lg text-venturare-muted/80 mb-10">
          {SOBRE_CTA_SUB}
        </p>
        <div class="flex justify-center">
          <Button href="/conversar" variant="primary" size="lg">
            Conversar com a Venturare
            <span class="ml-1">&rarr;</span>
          </Button>
        </div>
      </div>
    </Container>
  </Section>

</PageLayout>

<style>
  .sobre-grid {
    background-image:
      linear-gradient(rgba(245, 247, 246, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(245, 247, 246, 0.03) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse 85% 70% at 50% 50%, black 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 85% 70% at 50% 50%, black 20%, transparent 75%);
  }

  .sobre-glow-navy {
    background: radial-gradient(ellipse 55% 45% at 72% 25%, rgba(26, 54, 88, 0.45), transparent 65%);
  }
</style>