---
import PageLayout from '@/layouts/PageLayout.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import CTA from '@/components/ui/CTA.astro';
import ExperienceCard from '@/components/cards/ExperienceCard.astro';
import DomainCard from '@/components/cards/DomainCard.astro';

const ctxIcons = [
  `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>`,
  `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 9 5-9 5-9-5Z"/><path d="m3 13 9 5 9-5"/></svg>`,
  `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="12" r="6"/><circle cx="15" cy="12" r="6"/></svg>`,
];
import { getCollection } from 'astro:content';
import { generateWebPageJsonLd } from '@/lib/json-ld';
import {
  SITE_URL,
  EXPERIENCE_HERO,
  EXPERIENCE_SUB,
  EXPERIENCE_CONTEXTS,
  CONFIDENTIAL_TITLE,
  CONFIDENTIAL_TEXT,
  EXPERIENCE_CLOSING_HEADLINE,
  EXPERIENCE_CLOSING_TEXT,
} from '@/lib/constants';

const experiences = (await getCollection('experiences'))
  .filter((exp) => !exp.data.confidential)
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured));

const jsonLd = JSON.stringify(generateWebPageJsonLd({
  title: 'Experiências',
  description: 'Transformações em ambientes que exigem precisão, decisões de tecnologia em escala e estratégia na interseção com a execução.',
  url: `${SITE_URL}/experiencias`,
}));
---

<PageLayout
  title="Experiências"
  description="Transformações em ambientes que exigem precisão, decisões de tecnologia em escala e estratégia na interseção com a execução."
  jsonLd={jsonLd}
>

  {/* ═══════════════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════════════ */}
  <Section class="pt-16 lg:pt-28 pb-16 lg:pb-24">
    <Container>
      <div class="max-w-4xl">
        <Eyebrow text="Experiências" class="mb-8" />
        <Heading tag="h1" size="hero" class="mb-8 text-balance">
          {EXPERIENCE_HERO}
        </Heading>
        <p class="text-body-xl text-venturare-muted/80 max-w-2xl leading-relaxed">
          {EXPERIENCE_SUB}
        </p>
      </div>
    </Container>
  </Section>

  {/* ═══════════════════════════════════════════════════
       CONTEXTOS DE ATUAÇÃO
       ═══════════════════════════════════════════════════ */}
  <Section padding="xl" border>
    <Container>
      <div class="max-w-3xl mb-16">
        <Eyebrow text="Contextos de atuação" />
        <Heading tag="h2" size="h2" class="mb-6">
          Onde a complexidade pede compreensão
        </Heading>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {EXPERIENCE_CONTEXTS.map((ctx, i) => (
          <DomainCard
            index={i + 1}
            title={ctx.title}
            description={ctx.description}
            icon={ctxIcons[i]}
            eyebrow={`Contexto ${ctx.index}`}
          />
        ))}
      </div>
    </Container>
  </Section>

  {/* ═══════════════════════════════════════════════════
       EXPERIÊNCIAS PUBLICADAS
       ═══════════════════════════════════════════════════ */}
  {experiences.length > 0 && (
    <Section padding="xl" border>
      <Container>
        <div class="max-w-3xl mb-14">
          <Eyebrow text="Casos reais" />
          <Heading tag="h2" size="h2" class="mb-6">
            Experiências compartilhadas
          </Heading>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {experiences.map((experience) => (
            <ExperienceCard
              title={experience.data.title}
              description={experience.data.description}
              industry={experience.data.industry}
              href={`/experiencias/${experience.id}/`}
              confidential={experience.data.confidential}
            />
          ))}
        </div>
      </Container>
    </Section>
  )}

  {/* ═══════════════════════════════════════════════════
       CONFIDENCIALIDADE
       ═══════════════════════════════════════════════════ */}
  <Section padding="xl" border>
    <Container>
      <div class="max-w-3xl mx-auto text-center">
        <Eyebrow text="Confidencialidade" class="mb-8" />
        <Heading tag="h2" size="h2" class="mb-6 text-balance">
          {CONFIDENTIAL_TITLE}
        </Heading>
        <p class="text-body-lg text-venturare-muted/80 max-w-2xl mx-auto leading-relaxed">
          {CONFIDENTIAL_TEXT}
        </p>
      </div>
    </Container>
  </Section>

  {/* ═══════════════════════════════════════════════════
       FECHAMENTO + CTA
       ═══════════════════════════════════════════════════ */}
  <CTA
    title={EXPERIENCE_CLOSING_HEADLINE}
    sub={EXPERIENCE_CLOSING_TEXT}
    primaryLabel="Conversar"
    primaryHref="/conversar"
  />

</PageLayout>