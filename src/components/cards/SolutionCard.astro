---
import Badge from '@/components/ui/Badge.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  class?: string;
}

const { title, description, href, class: className = '' } = Astro.props;
---

<a href={href} class:list={['group block card-hover', className]}>
  <div class="flex flex-col h-full">
    <div class="flex items-center gap-2 mb-4">
      <Badge text="Solução" variant="category" />
    </div>
    <h3 class="text-h4 text-foreground mb-3 group-hover:text-accent transition-colors duration-200">
      {title}
    </h3>
    <p class="text-small text-muted/85 leading-relaxed flex-1">
      {description}
    </p>
    <div class="mt-6 flex items-center gap-2 text-small text-muted/70 group-hover:text-accent transition-colors duration-200">
      <span>Saiba mais</span>
      <span class="transition-transform duration-200 group-hover:translate-x-1">&rarr;</span>
    </div>
  </div>
</a>
