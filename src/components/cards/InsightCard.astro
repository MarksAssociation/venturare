---
import Badge from '@/components/ui/Badge.astro';
import { getCategoryLabel, formatDate, getReadingTimeText } from '@/lib/utils';

interface Props {
  title: string;
  description: string;
  category: string;
  date: Date;
  readingTime: number;
  tags: string[];
  href: string;
  coverImage?: string;
  class?: string;
}

const { title, description, category, date, readingTime, tags, href, coverImage, class: className = '' } = Astro.props;
---

<a href={href} class:list={['group block card-hover overflow-hidden', className]}>
  {coverImage && (
    <div class="aspect-[16/9] overflow-hidden rounded mb-4 -mx-6 -mt-6 px-6 pt-6">
      <img
        src={coverImage}
        alt=""
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        loading="lazy"
      />
    </div>
  )}
  <div class="flex flex-col h-full">
    <div class="flex items-center gap-2 mb-4">
      <Badge text={getCategoryLabel(category)} variant="category" />
    </div>
    <h3 class="text-h4 text-foreground mb-3 group-hover:text-accent transition-colors duration-200 line-clamp-2">
      {title}
    </h3>
    <p class="text-small text-muted/85 leading-relaxed flex-1 line-clamp-3 mb-4">
      {description}
    </p>
    <div class="flex items-center gap-3 text-caption text-muted/70">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span class="text-border">|</span>
      <span>{getReadingTimeText(readingTime)}</span>
    </div>
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-4">
        {tags.slice(0, 3).map((tag: string) => (
          <span class="text-caption text-muted/70">#{tag}</span>
        ))}
      </div>
    )}
  </div>
</a>
