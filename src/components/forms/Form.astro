---
import { CONTACT_FIELDS, CONTACT_LOOKING_FOR, CONTACT_SUBMIT, CONTACT_SUCCESS_TITLE, CONTACT_SUCCESS_TEXT } from '@/lib/constants';
import Button from '@/components/ui/Button.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const endpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT as string | undefined;
const configured = typeof endpoint === 'string' && endpoint.length > 0;
---


<form id="contact-form" method="post" action={endpoint} class:list={['grid grid-cols-1 gap-6', className]}>
  {configured && <input type="hidden" name="form-name" value="conversar" />}

  {CONTACT_FIELDS.map((field) => (
    <div>
      <label class="label" for={`field-${field.name}`}>{field.label}</label>
      <input
        class="input"
        type={field.type}
        id={`field-${field.name}`}
        name={field.name}
        placeholder={field.placeholder}
        required={field.required}
        autocomplete={
          field.name === 'name' ? 'name'
          : field.name === 'email' ? 'email'
          : field.name === 'phone' ? 'tel'
          : 'off'
        }
      />
    </div>
  ))}

  <div>
    <label class="label" for="field-subject">O que você busca?</label>
    <select class="input" id="field-subject" name="subject">
      {CONTACT_LOOKING_FOR.map((option) => (
        <option value={option.value}>{option.label}</option>
      ))}
    </select>
  </div>

  <div>
    <label class="label" for="field-message">Sobre o desafio</label>
    <textarea class="input min-h-36" id="field-message" name="message" rows="5"></textarea>
  </div>

  <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
    <button type="submit" class="btn btn-primary" disabled={!configured}>
      {CONTACT_SUBMIT}
    </button>
    <span id="form-status" class="text-small text-muted/75" role="status" aria-live="polite"></span>
  </div>
  {!configured && (
    <p class="text-small text-muted/70">
      O canal de mensagens será ativado em breve. Por enquanto, escreva diretamente pelo e-mail disponível nesta página.
    </p>
  )}
</form>

<div id="contact-success" class="hidden" role="status">
  <div class="w-12 h-12 rounded-full border border-accent/40 bg-accent/10 flex items-center justify-center mb-8" aria-hidden="true">
    <svg class="w-5 h-5 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 12.5l5 5 10-11" /></svg>
  </div>
  <h2 id="contact-success-title" tabindex="-1" class="text-h3 font-display font-semibold text-foreground tracking-tight mb-6 outline-none">
    {CONTACT_SUCCESS_TITLE}
  </h2>
  <p class="text-body-lg text-muted/80 leading-relaxed max-w-xl mb-10">
    {CONTACT_SUCCESS_TEXT}
  </p>
  <Button href="/" variant="secondary">
    Voltar ao início
  </Button>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  if (form && status) {
    form.addEventListener('submit', async (event) => {
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (button?.disabled) {
        event.preventDefault();
        return;
      }
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      status.textContent = 'Enviando...';
      if (button) button.disabled = true;
      try {
        const data = new FormData(form);
        const email = (form.querySelector('input[type="email"]') as HTMLInputElement | null)?.value.trim() ?? '';
        const tema = (form.querySelector('select[name="subject"]') as HTMLSelectElement | null)?.selectedOptions[0]?.textContent?.trim() ?? '';
        if (email) data.set('_replyto', email);
        data.set('_subject', tema ? `Novo contato pelo site Venturare — ${tema}` : 'Novo contato pelo site Venturare');
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        if (!response.ok) throw new Error('network');
        form.reset();
        form.classList.add('hidden');
        const panel = document.getElementById('contact-success');
        if (panel) {
          panel.classList.remove('hidden');
          const title = document.getElementById('contact-success-title');
          if (title instanceof HTMLElement) title.focus();
        }
      } catch {
        status.textContent = 'Não foi possível enviar agora. Tente novamente em instantes.';
        if (button) button.disabled = false;
      }
    });
  }
</script>