---
interface Props {
  text: string;
  class?: string;
  color?: 'green' | 'muted' | 'white' | 'dark';
}

const { text, class: className = '', color = 'green' } = Astro.props;

const colorClasses = {
  green: 'text-accent',
  muted: 'text-muted',
  white: 'text-foreground',
  dark: 'text-accent-dim',
};
---

<span class:list={['inline-block text-eyebrow font-semibold uppercase tracking-widest mb-4', colorClasses[color], className]}>
  {text}
</span>
