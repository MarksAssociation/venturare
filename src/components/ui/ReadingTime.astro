---
import { getReadingTimeText } from '@/lib/utils';

interface Props {
  minutes: number;
  class?: string;
}

const { minutes, class: className = '' } = Astro.props;
---

<span class:list={['text-caption text-muted/70', className]} aria-label={getReadingTimeText(minutes)}>
  {getReadingTimeText(minutes)}
</span>