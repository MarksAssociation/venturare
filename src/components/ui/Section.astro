---
interface Props {
  id?: string;
  class?: string;
  as?: 'section' | 'div' | 'article';
  padding?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  border?: boolean;
  tone?: 'dark' | 'light' | 'subtle';
}

const { id, class: className = '', as: Tag = 'section', padding = 'lg', border = false, tone = 'dark' }: Props = Astro.props;

const paddingClasses: Record<string, string> = {
  none: '',
  sm: 'py-8 lg:py-12',
  md: 'py-12 lg:py-16',
  lg: 'py-20 lg:py-32',
  xl: 'py-20 lg:py-28',
};

const toneClasses = {
  dark: '',
  light: 'bg-surface-elevated text-foreground',
  subtle: 'bg-surface/40',
};
---

<Tag id={id} class:list={[paddingClasses[padding] || '', border && 'section-border', toneClasses[tone], className]}>
  <slot />
</Tag>
