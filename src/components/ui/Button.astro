---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'text';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  target?: '_blank' | '_self';
  rel?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
  target,
  rel,
} = Astro.props;

const baseClasses = 'inline-flex items-center justify-center gap-2 font-button rounded transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:opacity-50 disabled:cursor-not-allowed';

const variantClasses = {
  primary: 'bg-accent text-green-fg hover:bg-accent/90 active:bg-accent-dim',
  secondary: 'border border-border text-muted hover:border-accent/50 hover:text-foreground active:border-accent active:text-accent',
  ghost: 'text-muted hover:text-accent active:text-accent-dim',
  text: 'text-muted hover:text-accent gap-1.5',
};

const sizeClasses = {
  sm: 'px-4 py-1.5 text-button',
  md: 'px-5 py-2.5 text-button',
  lg: 'px-7 py-3 text-button',
};

const classes = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
---

{href ? (
  <a href={href} class:list={[classes, variant === 'text' && 'group']} target={target} rel={rel}>
    <slot />
    {variant === 'text' && <span class="transition-transform duration-200 group-hover:translate-x-0.5">&rarr;</span>}
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
  </button>
)}
