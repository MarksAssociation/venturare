---
interface Props {
  href: string;
  class?: string;
  target?: '_blank' | '_self';
  rel?: string;
}

const { href, class: className = '', target, rel } = Astro.props;
---

<a
  href={href}
  class:list={['text-venturare-muted hover:text-venturare-green transition-colors duration-150 underline underline-offset-4 decoration-venturare-border/40 hover:decoration-venturare-green/60', className]}
  target={target}
  rel={rel}
>
  <slot />
</a>
