---
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import Heading from '@/components/ui/Heading.astro';
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  highlight?: string;
  sub?: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  highlight,
  sub,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  class: className = '',
} = Astro.props;
---

<Section class:list={['border-t border-border/20', className]}>
  <Container>
    <div class="max-w-4xl mx-auto text-center">
      {eyebrow && <Eyebrow text={eyebrow} class="mb-6" />}
      {title && (
        <Heading tag="h2" size="h2" class="mb-6 text-balance">
          {title}
          {highlight && <><br /><span class="text-accent">{highlight}</span></>}
        </Heading>
      )}
      {sub && <p class="text-body-lg text-muted/80 max-w-2xl mx-auto mb-10 leading-relaxed">{sub}</p>}
      <div class="flex flex-wrap items-center justify-center gap-4">
        <Button href={primaryHref} variant="primary">
          {primaryLabel}
          <span class="ml-1">&rarr;</span>
        </Button>
        {secondaryLabel && secondaryHref && (
          <Button href={secondaryHref} variant="secondary">
            {secondaryLabel}
            <span class="ml-1">&rarr;</span>
          </Button>
        )}
      </div>
    </div>
  </Container>
</Section>