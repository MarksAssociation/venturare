---
import { NAV_ITEMS } from '@/lib/constants';
import Container from '@/components/ui/Container.astro';
import Logo from '@/components/brand/Logo.astro';

const currentPath = Astro.url.pathname;

interface NavItem {
  label: string;
  href: string;
  isCta?: boolean;
}

const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" data-header>
  <div class="absolute inset-0 bg-venturare-black/0 backdrop-blur-none transition-all duration-300" data-header-bg></div>

  <Container>
    <nav class="relative flex items-center justify-between h-16 lg:h-20" aria-label="Navegação principal">
      <Logo size="lg" eager class="-my-2 py-2" />

      <ul class="hidden lg:flex items-center gap-8">
        {NAV_ITEMS.map((item: NavItem) => (
          <li>
            <a
              href={item.href}
              class:list={[
                item.isCta
                  ? 'btn-primary text-button px-5 py-2 ml-2'
                  : 'text-small text-venturare-muted/90 hover:text-venturare-white transition-colors duration-200 relative py-1',
                !item.isCta && isActive(item.href) && 'text-venturare-white',
              ]}
              aria-current={!item.isCta && isActive(item.href) ? 'page' : undefined}
              {...(item.isCta ? {} : {})}
            >
              {item.label}
              {!item.isCta && isActive(item.href) && (
                <span class="absolute bottom-0 left-0 right-0 h-px bg-venturare-green"></span>
              )}
            </a>
          </li>
        ))}
      </ul>

      <button
        id="mobile-menu-toggle"
        class="lg:hidden text-venturare-muted hover:text-venturare-white p-2 transition-colors duration-200"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </nav>
  </Container>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-venturare-border/20 bg-venturare-black/98 backdrop-blur-md">
    <Container>
      <div class="py-6">
        <ul class="flex flex-col gap-1">
          {NAV_ITEMS.map((item: NavItem) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  item.isCta
                    ? 'btn-primary text-center mt-4 py-3 px-3'
                    : 'block text-body text-venturare-muted hover:text-venturare-white transition-colors duration-150 py-3 px-3 -mx-3 rounded',
                  !item.isCta && isActive(item.href) && 'text-venturare-white bg-venturare-graphite/50',
                ]}
                aria-current={!item.isCta && isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </div>
</header>

<div id="header-spacer" class="h-16 lg:h-20"></div>

<script>
  function initHeader() {
    const headerEl = document.getElementById('site-header');
    const bgEl = headerEl?.querySelector('[data-header-bg]');
    const mobileToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');

    if (!headerEl || !bgEl) return;

    const header = headerEl;
    const headerBg = bgEl as HTMLElement;

    let ticking = false;

    function updateHeader() {
      const scrollY = window.scrollY;

      if (scrollY > 50) {
        headerBg.classList.remove('bg-venturare-black/0', 'backdrop-blur-none');
        headerBg.classList.add('bg-venturare-black/80', 'backdrop-blur-md');
        header.classList.add('border-b', 'border-venturare-border/20');
      } else {
        headerBg.classList.add('bg-venturare-black/0', 'backdrop-blur-none');
        headerBg.classList.remove('bg-venturare-black/80', 'backdrop-blur-md');
        header.classList.remove('border-b', 'border-venturare-border/20');
      }

      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateHeader);
        ticking = true;
      }
    }, { passive: true });

    if (mobileToggle && mobileMenu) {
      mobileToggle.addEventListener('click', () => {
        const isOpen = !mobileMenu.classList.contains('hidden');
        mobileMenu.classList.toggle('hidden');
        mobileToggle.setAttribute('aria-expanded', String(!isOpen));
        mobileToggle.setAttribute('aria-label', !isOpen ? 'Fechar menu' : 'Abrir menu');
      });

      mobileMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          mobileToggle.setAttribute('aria-expanded', 'false');
          mobileToggle.setAttribute('aria-label', 'Abrir menu');
        });
      });
    }

    updateHeader();
  }

  initHeader();
  document.addEventListener('astro:after-swap', initHeader);
</script>
