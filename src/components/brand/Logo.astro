---
interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg';
  eager?: boolean;
}

const {
  class: className = '',
  size = 'md',
  eager = false,
} = Astro.props;

const sizeClasses = {
  sm: { symbol: 'h-7 lg:h-8', wordmark: 'h-3 lg:h-3.5', gap: 'gap-2' },
  md: { symbol: 'h-9 lg:h-12', wordmark: 'h-3.5 lg:h-[1.125rem]', gap: 'gap-2.5' },
  lg: { symbol: 'h-10 lg:h-11', wordmark: 'h-3.5 lg:h-4', gap: 'gap-2.5' },
};
---

<a
  href="/"
  class:list={['inline-flex items-center', className]}
  aria-label="Venturare — página inicial"
>
  <span class:list={['flex items-center', sizeClasses[size].gap]}>
    <span
      class:list={['relative block shrink-0 overflow-hidden', sizeClasses[size].symbol]}
      style="aspect-ratio: 659/521"
    >
      <img
        src="/brand/Venturare_transparente.png"
        alt=""
        width="1536"
        height="1024"
        class="absolute block"
        style="width: 233.08%; max-width: none; height: auto; left: -63.73%; top: -34.74%;"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    </span>
    <span
      class:list={['relative block shrink-0 overflow-hidden', sizeClasses[size].wordmark]}
      style="aspect-ratio: 878/102"
    >
    <img
      src="/brand/Venturare_transparente.png"
      alt=""
      width="1536"
      height="1024"
      class="absolute block"
      style="width: 174.94%; max-width: none; height: auto; left: -34.74%; top: -745.10%; filter: brightness(0) invert(1);"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
    </span>
  </span>
</a>
