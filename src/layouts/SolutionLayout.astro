---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Heading from '@/components/ui/Heading.astro';
import Button from '@/components/ui/Button.astro';
import type { SolutionDetail } from '@/lib/constants';
import { SOLUTIONS } from '@/lib/constants';

interface Props {
  detail: SolutionDetail;
  description: string;
  jsonLd: string;
}

const { detail, description, jsonLd } = Astro.props;
const solutionTitle = SOLUTIONS.find((s) => s.id === detail.id)?.title ?? 'Soluções';
---

<BaseLayout title={detail.hero} description={description} jsonLd={jsonLd}>

  {/* ═══════════════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════════════ */}
  <Section class="pt-16 lg:pt-28 pb-16 lg:pb-24">
    <Container>
      <div class="max-w-4xl">
        <Eyebrow text={`Soluções · ${solutionTitle}`} class="mb-8" />
        <Heading tag="h1" size="hero" class="mb-8 text-balance">
          {detail.hero}
        </Heading>
        <p class="text-body-xl text-venturare-muted/80 max-w-2xl leading-relaxed">
          {detail.sub}
        </p>
      </div>
    </Container>
  </Section>

  {/* ═══════════════════════════════════════════════════
       REALIDADE
       ═══════════════════════════════════════════════════ */}
  <Section padding="xl" border>
    <Container>
      <div class="max-w-4xl mx-auto text-center">
        <Eyebrow text="A realidade" class="mb-8" />
        <p class="text-h2 font-display font-bold text-venturare-white tracking-tight text-balance">
          {detail.reality}
        </p>
        {detail.principle && (
          <p class="text-h2 text-venturare-green font-display font-bold tracking-tight mt-10 text-balance">
            {detail.principle.label}
          </p>
        )}
      </div>
    </Container>
  </Section>

  {/* ═══════════════════════════════════════════════════
       OFERTAS / MODOS
       ═══════════════════════════════════════════════════ */}
  <Section padding="xl" border>
    <Container>
      <div class="max-w-3xl mb-16">
        <Eyebrow text={detail.introType === 'ofertas' ? 'Ofertas' : 'Modos de atuação'} />
        <Heading tag="h2" size="h2" class="mb-6">
          {detail.introType === 'ofertas' ? 'Como atuamos neste domínio' : 'Três modos de suportar a execução'}
        </Heading>
      </div>

      <div class="max-w-5xl divide-y divide-venturare-border/20">
        {detail.intros.map((item, i) => (
          <div class="py-8 lg:py-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-8 items-baseline">
              <div class="lg:col-span-2">
                <span class="text-h4 font-display font-extrabold tracking-tighter text-venturare-green/60">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>
              <div class="lg:col-span-5">
                <h3 class="text-h3 text-venturare-white font-display font-semibold tracking-tight">
                  {item.name}
                </h3>
              </div>
              {item.detail && (
                <div class="lg:col-span-5 lg:col-start-8">
                  <p class="text-body-lg text-venturare-muted/80 leading-relaxed">
                    {item.detail}
                  </p>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      {detail.ia && (
        <div class="mt-16 max-w-4xl">
          <div class="border-l-2 border-venturare-green/40 pl-6 lg:pl-8">
            <p class="text-h4 text-venturare-white font-display font-bold tracking-tight mb-4">
              {detail.ia.label}
            </p>
            <p class="text-body-lg text-venturare-muted/80 leading-relaxed">
              {detail.ia.note}
            </p>
          </div>
        </div>
      )}
    </Container>
  </Section>

  {/* ═══════════════════════════════════════════════════
       CAPACIDADES
       ═══════════════════════════════════════════════════ */}
  <Section padding="xl" border class="pt-12 lg:pt-16">
    <Container>
      <div class="max-w-3xl mb-14">
        <Eyebrow text="Capacidades" />
        <Heading tag="h2" size="h2" class="mb-6">
          O que entregamos ao longo do percurso
        </Heading>
      </div>
      <div class="max-w-4xl">
        <div class="grid grid-cols-2 md:grid-cols-3 gap-px bg-venturare-border/20">
          {detail.capabilities.map((cap, i) => (
            <div class="bg-background p-6 lg:p-8">
              <p class="text-caption text-venturare-green/60 uppercase tracking-widest mb-3">{String(i + 1).padStart(2, '0')}</p>
              <p class="text-body text-venturare-white/90 font-display font-semibold">{cap}</p>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </Section>

  {/* ═══════════════════════════════════════════════════
       ABORDAGEM
       ═══════════════════════════════════════════════════ */}
  <Section padding="xl" border>
    <Container>
      <div class="max-w-3xl mx-auto text-center mb-16">
        <Eyebrow text="Abordagem" />
        <Heading tag="h2" size="h2" class="mb-6">
          O percurso dentro do domínio
        </Heading>
      </div>
      <div class="max-w-5xl mx-auto flex flex-wrap items-center justify-center gap-x-4 gap-y-4">
        {detail.approach.map((step, i) => (
          <>
            <span class="text-body-xl text-venturare-white font-display font-bold tracking-wide">{step}</span>
            {i < detail.approach.length - 1 && (
              <span class="text-venturare-green/60" aria-hidden="true">&rarr;</span>
            )}
          </>
        ))}
      </div>
      </div>
    </Container>
  </Section>

  {/* ═══════════════════════════════════════════════════
       FECHAMENTO + CTA
       ═══════════════════════════════════════════════════ */}
  <Section padding="xl">
    <Container>
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-h3 font-display font-bold text-venturare-white tracking-tight text-balance mb-10">
          {detail.closing}
        </p>
        <div class="flex justify-center">
          <Button href="/conversar" variant="primary" size="lg">{detail.cta}<span class="ml-1">&rarr;</span></Button>
        </div>
      </div>
    </Container>
  </Section>

</BaseLayout>