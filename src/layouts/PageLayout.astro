---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
  jsonLd?: string;
}

const { title, description, image, canonicalUrl, jsonLd } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <slot />
</BaseLayout>
